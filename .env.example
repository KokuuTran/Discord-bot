# ==========================================
# CẤU HÌNH AI DISCORD BOT (Đa nền tảng)
# ==========================================

# 1. Token của Discord Bot (Lấy từ https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# 2. AI API Key:
# - OpenRouter (Miễn phí): Lấy key tại https://openrouter.ai/keys (bắt đầu bằng sk-or-v1-...)
# - DeepSeek chính chủ: https://platform.deepseek.com/api_keys (sk-...)
# - Groq Cloud siêu tốc: https://console.groq.com/keys (gsk_...)
# - OpenAI ChatGPT: https://platform.openai.com/api-keys (sk-proj-...)
AI_API_KEY=your_ai_api_key_here

# 3. Base URL (Mặc định dùng OpenRouter để xài model Free):
# - OpenRouter: https://openrouter.ai/api/v1
# - DeepSeek: https://api.deepseek.com
# - Groq: https://api.groq.com/openai/v1
# - OpenAI: https://api.openai.com/v1
AI_BASE_URL=https://openrouter.ai/api/v1

# 4. Model AI mặc định:
# - OpenRouter Free: deepseek/deepseek-chat:free, deepseek/deepseek-r1:free, google/gemini-2.0-flash-exp:free
# - DeepSeek chính chủ: deepseek-chat, deepseek-reasoner
# - Groq: llama-3.3-70b-versatile
# - OpenAI: gpt-4o-mini
AI_MODEL=deepseek/deepseek-chat:free

# 5. ID Chủ bot tối cao (Mặc định: 1124340099111473232)
OWNER_ID=1124340099111473232
