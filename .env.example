# ==========================================
# CẤU HÌNH DISCORD BOT DEEPSEEK
# ==========================================

# 1. Token của Discord Bot (Lấy từ https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# 2. API Key cho DeepSeek (Lấy từ https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 3. Base URL của DeepSeek (Mặc định: https://api.deepseek.com)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 4. Model DeepSeek muốn sử dụng:
# - deepseek-chat : Model DeepSeek-V3 (siêu nhanh, chi phí rẻ, thông minh)
# - deepseek-reasoner : Model DeepSeek-R1 (suy luận logic từng bước chuyên sâu)
DEEPSEEK_MODEL=deepseek-chat

# 5. ID Chủ bot (Mặc định: 1124340099111473232)
OWNER_ID=1124340099111473232
